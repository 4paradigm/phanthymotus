# Unified Perception image for the Navigation card.
#
# Build every navigation component from its locked source revision.  The image
# depends only on the shared ROS base; no prebuilt FAST-LIVO2 image or companion
# container is part of the build/runtime boundary.
ARG ROS_BASE_IMAGE=bj-warehouse.tencentcloudcr.com/phanthy-motus/ros-base@sha256:82d45949e7c3fd85e6baf4a2b24b384a3ec020a5e237c5f801bc2f2269ca649f
FROM ${ROS_BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG ROS_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu
ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG PYTHON_COLCON_VERSION=0.3.0-100
ARG PYTHON_PYTEST_VERSION=6.2.5-1ubuntu2
ARG ROS_NAV2_BRINGUP_VERSION_AMD64=1.1.20-1jammy.20260804.225407
ARG ROS_NAV2_BRINGUP_VERSION_ARM64=1.1.20-1jammy.20260805.020157
ARG ROS_NAVIGATION2_VERSION_AMD64=1.1.20-1jammy.20260804.223401
ARG ROS_NAVIGATION2_VERSION_ARM64=1.1.20-1jammy.20260805.013510
ARG ROS_RMW_FASTRTPS_CPP_VERSION_AMD64=6.2.10-1jammy.20260724.002510
ARG ROS_RMW_FASTRTPS_CPP_VERSION_ARM64=6.2.10-1jammy.20260725.133410
ARG GIT_MIRROR_PREFIX=https://ghfast.top/
ARG FAST_LIVO2_REPO=https://github.com/Rhymer-Lcy/FAST-LIVO2-ROS2-MID360-Fisheye.git
ARG FAST_LIVO2_COMMIT=1fcd0d05cadaeb25ca59fd87cda95aaaee41e3ea
ARG FAST_LIVO2_RUNTIME_PATCH_SHA256=534b15ab7559d572b1be56611ab1b5f5d73809f91727de5e853cd04612f4fc3b
ARG FAST_LIVO2_PCD_SAVE_PATCH_SHA256=b3afa3e64b5743898c829fe34891f828027eb372324d05a8c94357f9cacd6ec4
ARG RPG_VIKIT_REPO=https://github.com/Rhymer-Lcy/rpg_vikit_ros2_fisheye.git
ARG RPG_VIKIT_COMMIT=0b5548d9adab58128f3a59a507e96a83acfa8fdf
ARG LIVOX_ROS_DRIVER2_REPO=https://github.com/Livox-SDK/livox_ros_driver2.git
ARG LIVOX_ROS_DRIVER2_COMMIT=13eb05e4e6dd7a765b934d0c5fd6236676a57b49
ARG LIVOX_SDK2_REPO=https://github.com/Livox-SDK/Livox-SDK2.git
ARG LIVOX_SDK2_COMMIT=f5d9375f84efe2b15bc0a052d3e18482ed13adf4
ARG SOPHUS_REPO=https://github.com/strasdat/Sophus.git
ARG SOPHUS_COMMIT=de0f8d3d92bf776271e16de56d1803940ebccab9

RUN set -eu; \
    ros_mirror="${ROS_MIRROR#https://}"; \
    ros_mirror="${ros_mirror#http://}"; \
    install -m 0644 \
      /usr/share/ros-apt-source/ros2.sources \
      /etc/apt/sources.list.d/ros2.sources; \
    for source in \
      /etc/apt/sources.list \
      /etc/apt/sources.list.d/*.list \
      /etc/apt/sources.list.d/*.sources; do \
      [ -f "${source}" ] || continue; \
      sed -E -i \
        "s|https?://ports\\.ubuntu\\.com/ubuntu-ports|https://${APT_MIRROR}/ubuntu-ports|g; \
         s|https?://mirrors\\.tencentyun\\.com/ubuntu-ports|https://${APT_MIRROR}/ubuntu-ports|g; \
         s|https?://packages\\.ros\\.org/ros2/ubuntu|https://${ros_mirror}|g; \
         /^[[:space:]]*deb-src[[:space:]]/d; \
         s|^Types:[[:space:]]*deb[[:space:]]+deb-src[[:space:]]*$|Types: deb|; \
         s|^Types:[[:space:]]*deb-src([[:space:]]+deb)?[[:space:]]*$|Types: deb|" \
        "${source}"; \
    done; \
    if grep -R -E \
      'https?://(ports\.ubuntu\.com/ubuntu-ports|packages\.ros\.org/ros2/ubuntu)' \
      /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then \
      echo 'official Ubuntu or ROS APT source remains after mirror rewrite' >&2; \
      exit 1; \
    fi; \
    if grep -R -E \
      '^[[:space:]]*deb-src[[:space:]]|^Types:.*deb-src' \
      /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then \
      echo 'APT source-package entries remain after binary-only rewrite' >&2; \
      exit 1; \
    fi

RUN arch="$(dpkg --print-architecture)" && \
    case "${arch}" in \
      amd64) \
        nav2_bringup_version="${ROS_NAV2_BRINGUP_VERSION_AMD64}"; \
        navigation2_version="${ROS_NAVIGATION2_VERSION_AMD64}"; \
        rmw_fastrtps_cpp_version="${ROS_RMW_FASTRTPS_CPP_VERSION_AMD64}"; \
        ;; \
      arm64) \
        nav2_bringup_version="${ROS_NAV2_BRINGUP_VERSION_ARM64}"; \
        navigation2_version="${ROS_NAVIGATION2_VERSION_ARM64}"; \
        rmw_fastrtps_cpp_version="${ROS_RMW_FASTRTPS_CPP_VERSION_ARM64}"; \
        ;; \
      *) echo "unsupported Debian architecture: ${arch}" >&2; exit 64 ;; \
    esac && \
    apt-get -o APT::Sandbox::User=root update && \
    apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
      build-essential \
      cmake \
      ffmpeg \
      espeak-ng \
      git \
      libapr1-dev \
      libboost-all-dev \
      libeigen3-dev \
      libfmt-dev \
      libopencv-dev \
      libpcl-dev \
      python3-pip \
      python3-colcon-common-extensions=${PYTHON_COLCON_VERSION} \
      python3-pytest=${PYTHON_PYTEST_VERSION} \
      ros-humble-ament-cmake-auto \
      ros-humble-cv-bridge \
      ros-humble-image-transport \
      ros-humble-nav2-bringup=${nav2_bringup_version} \
      ros-humble-navigation2=${navigation2_version} \
      ros-humble-pcl-conversions \
      ros-humble-pcl-ros \
      ros-humble-rmw-fastrtps-cpp=${rmw_fastrtps_cpp_version} \
      ros-humble-rosidl-default-generators \
      ros-humble-ros2bag \
      ros-humble-rosbag2-storage-mcap \
      ros-humble-tf2-geometry-msgs \
      ros-humble-tf2-ros \
      ros-humble-visualization-msgs && \
    rm -rf /var/lib/apt/lists/*

# Build the exact FAST-LIVO2 dependency graph from source. Every checkout is
# immutable and both G1 runtime patches are verified before they are applied.
RUN for revision in \
      "${FAST_LIVO2_COMMIT}" \
      "${RPG_VIKIT_COMMIT}" \
      "${LIVOX_ROS_DRIVER2_COMMIT}" \
      "${LIVOX_SDK2_COMMIT}" \
      "${SOPHUS_COMMIT}"; do \
      [[ "${revision}" =~ ^[0-9a-f]{40}$ ]] || { \
        echo "source revision is not a full Git SHA: ${revision}" >&2; exit 2; \
      }; \
    done

RUN git init /tmp/livox-sdk2 && \
    cd /tmp/livox-sdk2 && \
    git remote add origin "${GIT_MIRROR_PREFIX}${LIVOX_SDK2_REPO}" && \
    git fetch --depth 1 origin "${LIVOX_SDK2_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${LIVOX_SDK2_COMMIT}" && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --parallel 2 && \
    cmake --install build && \
    rm -rf /tmp/livox-sdk2 && \
    ldconfig

RUN git init /tmp/sophus && \
    cd /tmp/sophus && \
    git remote add origin "${GIT_MIRROR_PREFIX}${SOPHUS_REPO}" && \
    git fetch --depth 1 origin "${SOPHUS_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${SOPHUS_COMMIT}" && \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_SOPHUS_TESTS=OFF && \
    cmake --build build --parallel 2 && \
    cmake --install build && \
    rm -rf /tmp/sophus && \
    ldconfig

WORKDIR /opt/fast_livo_ws/src

RUN git init livox_ros_driver2 && \
    cd livox_ros_driver2 && \
    git remote add origin "${GIT_MIRROR_PREFIX}${LIVOX_ROS_DRIVER2_REPO}" && \
    git fetch --depth 1 origin "${LIVOX_ROS_DRIVER2_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${LIVOX_ROS_DRIVER2_COMMIT}" && \
    cp package_ROS2.xml package.xml && \
    cp -r launch_ROS2 launch

RUN git init rpg_vikit_ros2_fisheye && \
    cd rpg_vikit_ros2_fisheye && \
    git remote add origin "${GIT_MIRROR_PREFIX}${RPG_VIKIT_REPO}" && \
    git fetch --depth 1 origin "${RPG_VIKIT_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${RPG_VIKIT_COMMIT}"

RUN git init fast_livo && \
    cd fast_livo && \
    git remote add origin "${GIT_MIRROR_PREFIX}${FAST_LIVO2_REPO}" && \
    git fetch --depth 1 origin "${FAST_LIVO2_COMMIT}" && \
    git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${FAST_LIVO2_COMMIT}"

COPY perception/plugins/navigation/runtime/patches/fast-livo2-runtime.patch \
     /tmp/fast-livo2-runtime.patch
COPY perception/plugins/navigation/runtime/patches/fast-livo2-pcd-save.patch \
     /tmp/fast-livo2-pcd-save.patch
RUN [[ "${FAST_LIVO2_RUNTIME_PATCH_SHA256}" =~ ^[0-9a-f]{64}$ ]] && \
    [[ "${FAST_LIVO2_PCD_SAVE_PATCH_SHA256}" =~ ^[0-9a-f]{64}$ ]] && \
    printf '%s  %s\n' \
      "${FAST_LIVO2_RUNTIME_PATCH_SHA256}" \
      /tmp/fast-livo2-runtime.patch | sha256sum -c - && \
    printf '%s  %s\n' \
      "${FAST_LIVO2_PCD_SAVE_PATCH_SHA256}" \
      /tmp/fast-livo2-pcd-save.patch | sha256sum -c - && \
    cd /opt/fast_livo_ws/src/fast_livo && \
    git apply --check /tmp/fast-livo2-runtime.patch && \
    git apply /tmp/fast-livo2-runtime.patch && \
    git apply --check /tmp/fast-livo2-pcd-save.patch && \
    git apply /tmp/fast-livo2-pcd-save.patch && \
    git diff --check

WORKDIR /opt/fast_livo_ws
RUN source /opt/ros/humble/setup.bash && \
    colcon build \
      --executor sequential \
      --packages-select livox_ros_driver2 vikit_common vikit_ros \
      --cmake-args \
        -DROS_EDITION=ROS2 \
        -DDISTRO_ROS=humble \
        -DCMAKE_BUILD_TYPE=Release && \
    source install/setup.bash && \
    colcon build \
      --executor sequential \
      --packages-select fast_livo \
      --cmake-args -DCMAKE_BUILD_TYPE=Release

RUN strings /opt/fast_livo_ws/install/fast_livo/lib/fast_livo/fastlivo_mapping \
      > /tmp/fastlivo_mapping.strings && \
    grep -Fq "accepting current sample to resynchronize" \
      /tmp/fastlivo_mapping.strings && \
    grep -Fq "PCD checkpoint completed" /tmp/fastlivo_mapping.strings && \
    grep -Fq "PCD finalization completed" /tmp/fastlivo_mapping.strings && \
    ! grep -Fq "imu time stamp Jumps" /tmp/fastlivo_mapping.strings && \
    rm /tmp/fastlivo_mapping.strings

# Perception runtime dependencies use the selected domestic PyPI mirror in
# this ROS Jammy image; no JetPack/Focal ABI is copied across distributions.
ARG PYTORCH_VERSION=2.2.2
ARG TORCHAUDIO_VERSION=2.2.2
ARG TORCHVISION_VERSION=0.17.2
ARG NUMPY_VERSION=1.26.4
ARG OPENCV_PYTHON_VERSION=4.11.0.86
RUN pip3 install --no-cache-dir -i "${PYPI_MIRROR}" \
      "torch==${PYTORCH_VERSION}" \
      "torchaudio==${TORCHAUDIO_VERSION}" \
      "torchvision==${TORCHVISION_VERSION}" \
      "numpy==${NUMPY_VERSION}" \
      "opencv-python==${OPENCV_PYTHON_VERSION}" && \
    pip3 install --no-cache-dir -i "${PYPI_MIRROR}" \
      pyyaml requests silero-vad websockets webrtcvad websocket-client \
      dashscope kiss-icp scipy ultralytics sherpa-onnx phonemizer

# Keep the full Perception bundle functional in the unified image.  The VOP
# plugin uses Ultralytics' CLIP fork for open-vocabulary class embeddings and
# expects the locked ViT-B-32 weights below /work/weights.
ARG SETUPTOOLS_VERSION=75.8.2
ARG WHEEL_VERSION=0.45.1
ARG PACKAGING_VERSION=24.2
RUN pip3 install --no-cache-dir -i "${PYPI_MIRROR}" \
      "setuptools==${SETUPTOOLS_VERSION}" \
      "wheel==${WHEEL_VERSION}" \
      "packaging==${PACKAGING_VERSION}" && \
    pip3 install --no-cache-dir --no-deps --no-build-isolation \
      -i "${PYPI_MIRROR}" \
      "git+https://ghfast.top/https://github.com/ultralytics/CLIP.git@488e81a6711eea7346872b46ea928b367da8889d" && \
    pip3 install --no-cache-dir -i "${PYPI_MIRROR}" ftfy regex
RUN mkdir -p /work/weights/clip && \
    python3 -c "import urllib.request; urllib.request.urlretrieve('https://agi-phanthy-dev-1252788780.cos.ap-beijing.myqcloud.com/public/ViT-B-32.pt', '/work/weights/clip/ViT-B-32.pt')"

COPY deploy/ros-base/audio_msgs/ /perception_ros_ws/src/audio_msgs/
COPY perception/plugins/navigation/runtime/g1_fast_livo2/ \
     /perception_ros_ws/src/g1_fast_livo2/
COPY perception/plugins/navigation/runtime/g1_nav2/ \
     /perception_ros_ws/src/g1_nav2/
RUN source /opt/ros/humble/setup.bash && \
    source /opt/fast_livo_ws/install/setup.bash && \
    cd /perception_ros_ws && \
    colcon build --packages-select audio_msgs g1_fast_livo2 g1_nav2 \
      --symlink-install && \
    dpkg-query -W \
      python3-colcon-common-extensions \
      python3-pytest \
      ros-humble-nav2-bringup \
      ros-humble-navigation2 \
      ros-humble-rmw-fastrtps-cpp \
      > /opt/g1-nav2-package-lock.txt && \
    test "$(wc -l < /opt/g1-nav2-package-lock.txt)" -eq 5

COPY perception/plugins/navigation/runtime/g1_lio.yaml /config/g1_lio.yaml

WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY perception/utils/ /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/deploy/ /deploy/

ENV ROS_DOMAIN_ID=42 \
    RMW_IMPLEMENTATION=rmw_fastrtps_cpp \
    FASTDDS_BUILTIN_TRANSPORTS=UDPv4 \
    RCUTILS_LOGGING_BUFFERED_STREAM=1 \
    YOLO_CONFIG_DIR=/work

EXPOSE 15720 15721

LABEL org.opencontainers.image.title="Phanthy Motus unified Navigation Perception" \
      org.opencontainers.image.description="Single-card FAST-LIVO2, Nav2 and semantic navigation runtime" \
      org.opencontainers.image.licenses="Apache-2.0 AND GPL-2.0-only AND GPL-3.0-only" \
      org.opencontainers.image.fast-livo2-revision="${FAST_LIVO2_COMMIT}" \
      org.opencontainers.image.fast-livo2-runtime-patch="${FAST_LIVO2_RUNTIME_PATCH_SHA256}" \
      org.opencontainers.image.fast-livo2-pcd-save-patch="${FAST_LIVO2_PCD_SAVE_PATCH_SHA256}"

CMD ["/bin/bash", "-lc", \
     "source /opt/ros/humble/setup.bash && \
      source /opt/fast_livo_ws/install/setup.bash && \
      source /perception_ros_ws/install/setup.bash && \
      exec python3 /work/main.py"]
