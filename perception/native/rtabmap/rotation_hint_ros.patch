+
+void OdometryROS::callbackRotationHint(const geometry_msgs::msg::QuaternionStamped::ConstSharedPtr msg)
+{
+	if(this->isPaused() || !rotationHints_)
+	{
+		return;
+	}
+	const std::int64_t stamp = msg->header.stamp.sec < 0 || msg->header.stamp.nanosec >= 1000000000u ? 0 :
+			static_cast<std::int64_t>(msg->header.stamp.sec) * 1000000000LL + msg->header.stamp.nanosec;
+	const auto & q = msg->quaternion;
+	UScopeMutex lock(rotationHintMutex_);
+	rotationHints_->add(stamp, msg->header.frame_id, motus::Quaternion{q.x, q.y, q.z, q.w}, now().nanoseconds());
+}
+
+void OdometryROS::clearRotationHints()
+{
+	UScopeMutex lock(rotationHintMutex_);
+	if(rotationHints_)
+	{
+		rotationHints_->reset();
+	}
 }
 
