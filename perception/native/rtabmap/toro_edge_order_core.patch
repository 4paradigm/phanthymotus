+/** \brief Orders edges by their unordered vertex-id pair. Unlike pointer
+    order this is independent of allocation, stays valid when revertEdge()
+    swaps v1 and v2, and is unique because addEdge() rejects duplicates. **/
+template <class E>
+struct EdgeIdComparator{
+  inline bool operator() (const E& e1, const E& e2) const {
+    const int a1=std::min(e1->v1->id,e1->v2->id), b1=std::max(e1->v1->id,e1->v2->id);
+    const int a2=std::min(e2->v1->id,e2->v2->id), b2=std::max(e2->v1->id,e2->v2->id);
+    return a1<a2 || (a1==a2 && b1<b2);
+  }
+};
