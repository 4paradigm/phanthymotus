+// The private gateway appends same-stamp Odometry CDR and its trailer
+// to the existing compressed recovery bytes in SensorData.user_data.
+static bool unpackPairedOdom(const std::vector<uint8_t> & data,
+        nav_msgs::msg::Odometry & odom, size_t & prefix)
+{
+    constexpr size_t trailer = 10;
+    if(data.size() < trailer || std::memcmp(data.data()+data.size()-8, "MOTUSMP1", 8) != 0)
+        return false;
+    const size_t n = data[data.size()-trailer] | (size_t(data[data.size()-trailer+1]) << 8);
+    if(n == 0 || n > 2048 || n > data.size()-trailer)
+        return false;
+    prefix = data.size()-trailer-n;
+    if(prefix != 0 && prefix <= 12)
+        return false;
+    try
+    {
+        rclcpp::SerializedMessage wire(n);
+        auto & buffer = wire.get_rcl_serialized_message();
+        std::memcpy(buffer.buffer, data.data()+prefix, n);
+        buffer.buffer_length = n;
+        rclcpp::Serialization<nav_msgs::msg::Odometry> codec;
+        codec.deserialize_message(&wire, &odom);
+    }
+    catch(const std::exception &)
+    {
+        return false;
+    }
+    return true;
+}
