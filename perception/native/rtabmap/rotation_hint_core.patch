+}
+
+Transform Odometry::process(SensorData & data, const Transform & guessIn, OdometryInfo * info, const Transform & rotationSearchHint)
 {
 	UASSERT_MSG(data.id() >= 0, uFormat("Input data should have ID greater or equal than 0 (id=%d)!", data.id()).c_str());
 
@@ -648,6 +653,22 @@
 		}
 	}
 
+	// Keep the internally computed visual translation guess. This rotation is
+	// used only to initialize registration; it cannot initialize/reset _pose,
+	// populate the IMU cache, constrain gravity, or replace a failed estimate.
+	if(!rotationSearchHint.isNull() && !data.imageRaw().empty() &&
+		(this->getType() == kTypeF2M || this->getType() == kTypeF2F))
+	{
+		guess = Transform(
+				rotationSearchHint.r11(), rotationSearchHint.r12(), rotationSearchHint.r13(), guess.isNull()?0.0f:guess.x(),
+				rotationSearchHint.r21(), rotationSearchHint.r22(), rotationSearchHint.r23(), guess.isNull()?0.0f:guess.y(),
+				rotationSearchHint.r31(), rotationSearchHint.r32(), rotationSearchHint.r33(), guess.isNull()?0.0f:guess.z());
+		if(_force3DoF)
+		{
+			guess = guess.to3DoF();
+		}
+	}
+
 	UTimer time;
 
