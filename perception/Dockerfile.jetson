# JetPack 6.2 TensorRT-only perception image for TTS evaluation.
# The former JP5.1.1 all-plugin image is preserved as Dockerfile.jetson.jp511.

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:24.12-py3-igpu
FROM ${BASE_IMAGE}

ARG VITS2_RUNTIME_URL=http://172.28.4.81:34567/liaoqianqian/models/vits2-mix/vits2-mix-jp6-runtime.tar.gz
ARG VITS2_RUNTIME_SHA256=83a24d5d4a7ace48ab533cc255654bb0d79e3bd728125da01ffd1abca6d294e9
ARG LC1_RELEASE_URL=http://172.28.4.81:34567/liaoqianqian/models/lc1-jetson/lc1_jetson_bundle_lc1_v0_170k.tar.gz
ARG LC1_RELEASE_SHA256=6c097dabcc65f38121be78eecbe0bf71771f8fddf13ad14ca9a04d8e7160e8cc
ARG LC1_ENGINE_URL=http://172.28.4.81:34567/liaoqianqian/models/lc1-jetson/lc1_v0_170k_orin_engines.tar.gz
ARG LC1_ENGINE_SHA256=3df757ffd61debb1a15c55f841b2162e3766c80d44f92ac822c1e5af36dd71a6

USER root

# ROS Jazzy and TensorRT use the Ubuntu 24.04 system Python in one process.
RUN . /etc/os-release && test "$VERSION_CODENAME" = noble && \
    sed -i 's|http://ports.ubuntu.com/ubuntu-ports|https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports|g' \
      /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true
RUN printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "3";\n' \
      > /etc/apt/apt.conf.d/99-vits2-network && \
    apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg python3-yaml && \
    curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
      | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=arm64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu noble main" \
      > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-ros-base python3-colcon-common-extensions && \
    rm -rf /var/lib/apt/lists/*

COPY perception/utils/download_vits2_trt_runtime.py /tmp/download_vits2_trt_runtime.py
COPY perception/plugins/vits2_tts_trt/requirements.jetson.txt /tmp/vits2-trt-requirements.txt
RUN /usr/bin/python3 /tmp/download_vits2_trt_runtime.py \
      --url "$VITS2_RUNTIME_URL" --sha256 "$VITS2_RUNTIME_SHA256" \
      --output /tmp/vits2-mix-jp6-runtime.tar.gz && \
    mkdir -p /opt/vits2-runtime /models/vits2-mix/engines && \
    tar --no-same-owner -xzf /tmp/vits2-mix-jp6-runtime.tar.gz -C /opt/vits2-runtime && \
    cd /opt/vits2-runtime && sha256sum -c runtime/SHA256SUMS && \
    grep -qx 'architecture=aarch64' artifacts/jetson-deps/versions.txt && \
    grep -qx 'python=3.12.3' artifacts/jetson-deps/versions.txt && \
    cp -a artifacts/jetson-deps/openfst/lib/. /usr/local/lib/ && ldconfig && \
    /usr/bin/python3 -m pip install --no-cache-dir --no-index \
      --find-links=artifacts/jetson-deps/wheels -r /tmp/vits2-trt-requirements.txt && \
    /usr/bin/python3 -c "import ctypes,numpy,pynini,tn; ctypes.CDLL('libcudart.so')" && \
    cp -a runtime/nltk_data /models/vits2-mix/

# LC1 model resources are versioned outside the public repository, verified at
# build time, and baked into the image under the paths consumed by the plugin.
RUN /usr/bin/python3 /tmp/download_vits2_trt_runtime.py \
      --url "$LC1_RELEASE_URL" --sha256 "$LC1_RELEASE_SHA256" \
      --output /tmp/lc1-release.tar.gz && \
    /usr/bin/python3 /tmp/download_vits2_trt_runtime.py \
      --url "$LC1_ENGINE_URL" --sha256 "$LC1_ENGINE_SHA256" \
      --output /tmp/lc1-engines.tar.gz && \
    mkdir -p /opt/lc1 /models/vits2-mix/engines && \
    tar --no-same-owner -xzf /tmp/lc1-release.tar.gz -C /opt/lc1 && \
    tar --no-same-owner -xzf /tmp/lc1-engines.tar.gz \
      -C /opt/lc1/lc1_jetson_bundle && \
    cp -a /opt/lc1/lc1_jetson_bundle/engines/. /models/vits2-mix/engines/ && \
    cp -a /opt/lc1/lc1_jetson_bundle/tn_cache \
      /opt/lc1/lc1_jetson_bundle/frontend_data /models/vits2-mix/ && \
    cp /opt/lc1/lc1_jetson_bundle/config.json /models/vits2-mix/config.json && \
    /usr/bin/python3 -c "import json,pathlib; p=pathlib.Path('/models/vits2-mix/engines'); m=json.loads((p/'manifest.json').read_text()); assert m['architecture']=='aarch64'; assert m['compute_capability']=='8.7'; assert m['total_engine_bytes'] <= m.get('max_engine_bytes',64*1024*1024) <= 64*1024*1024; assert all((p/e['file']).stat().st_size==e['bytes'] for e in m['engines'].values())" && \
    rm -f /tmp/vits2-mix-jp6-runtime.tar.gz /tmp/lc1-release.tar.gz \
      /tmp/lc1-engines.tar.gz /tmp/vits2-trt-requirements.txt \
      /tmp/download_vits2_trt_runtime.py

COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && . /opt/ros/jazzy/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args \
      -DCMAKE_BUILD_TYPE=Release \
      -DPython3_EXECUTABLE=/usr/bin/python3 \
      -DPYTHON_EXECUTABLE=/usr/bin/python3 && \
    . /ros_ws/install/setup.bash && \
    /usr/bin/python3 -c "import rclpy,yaml; from audio_msgs.msg import AudioChunk"

WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/vits2_tts_trt/ /work/plugins/vits2_tts_trt/
COPY perception/config.yaml /work/config.yaml
COPY perception/start_vits2_trt.sh /work/start_vits2_trt.sh

RUN cp /models/vits2-mix/frontend_data/cmudict.rep \
       /work/plugins/vits2_tts_trt/runtime/frontend/cmudict.rep && \
    cp /models/vits2-mix/frontend_data/cmudict_cache.pickle \
       /work/plugins/vits2_tts_trt/runtime/frontend/cmudict_cache.pickle && \
    test -s /models/vits2-mix/tn_cache/zh_tn_tagger.fst && \
    test -s /models/vits2-mix/tn_cache/zh_tn_verbalizer.fst && \
    test -s /models/vits2-mix/tn_cache/en_tn_tagger.fst && \
    test -s /models/vits2-mix/tn_cache/en_tn_verbalizer.fst && \
    test -s /models/vits2-mix/frontend_data/phrase_pinyin_data/di.py && \
    chmod 755 /work/start_vits2_trt.sh && \
    cd /work/plugins/vits2_tts_trt/runtime && \
    NLTK_DATA=/models/vits2-mix/nltk_data \
    EN_TN_CACHE_DIR=/models/vits2-mix/tn_cache \
    TN_CACHE_DIR=/models/vits2-mix/tn_cache \
    VITS2_FRONTEND_DATA_DIR=/models/vits2-mix/frontend_data \
    /usr/bin/python3 -c "from frontend.cleaner import clean_text_mix; [clean_text_mix(t) for t in ('你好。','AI助手现在ready了。','Mark今天想喝coffee。')]"

ENV LD_LIBRARY_PATH=/usr/local/lib:/ros_ws/install/audio_msgs/lib:/opt/ros/jazzy/lib:${LD_LIBRARY_PATH} \
    AMENT_PREFIX_PATH=/ros_ws/install/audio_msgs:/opt/ros/jazzy \
    NLTK_DATA=/models/vits2-mix/nltk_data \
    EN_TN_CACHE_DIR=/models/vits2-mix/tn_cache \
    TN_CACHE_DIR=/models/vits2-mix/tn_cache \
    VITS2_FRONTEND_DATA_DIR=/models/vits2-mix/frontend_data \
    MIX_VITS_CONFIG_PATH=/models/vits2-mix/config.json \
    MIX_VITS_TRT_ENGINE_DIR=/models/vits2-mix/engines \
    MIX_VITS_MAX_ENGINE_BYTES=67108864 \
    MIX_VITS_MAX_TEXT_TOKENS=256 \
    MIX_VITS_MAX_FRAMES=2048 \
    MIX_VITS_CHUNK_BYTES=3200 \
    MIX_VITS_FRAME_INTERVAL_MS=80 \
    MIX_VITS_ALLOW_FAST_DELIVERY=1 \
    TTS_PLUGIN=vits2_tts_trt \
    DEFAULT_TTS_PLUGIN=vits2_tts_trt \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

EXPOSE 15720 15721
ENTRYPOINT ["/work/start_vits2_trt.sh"]
