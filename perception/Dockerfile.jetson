# ── Jetson GPU variant (JetPack 6) ───────────────────────────────────
# Self-contained: builds jp6-torch from dustynv images (no private registry required).
# Matches local Jetson test: JP6 + CUDA PyTorch + GPU sherpa-onnx + TTS cuda in config.yaml.
#
# Build context: repo root (phanthy-motus/)
#   ./deploy/build_perception.sh --variant jetson --mirror tuna
#
# Optional: skip inline base build if you already have jp6-torch locally:
#   export BASE_IMAGE=local/phanthy-motus/jetson-base:jp6-torch
#   ./deploy/build_perception.sh --variant jetson
# ────────────────────────────────────────────────────────────────────

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG ROS_BASE=docker.m.daocloud.io/dustynv/ros:humble-desktop-l4t-r36.4.0
ARG PYTORCH_DONOR=docker.m.daocloud.io/dustynv/l4t-pytorch:r36.4.0
ARG BASE_IMAGE=
ARG SHERPA_ONNX_ENABLE_GPU=ON
ARG SHERPA_ONNX_GPU_ORT_VERSION=1.18.1
ARG SKIP_VOP_DEPS=ON

# ── Stage: jp6-torch (same as deploy/prepare_jp_v6_local.sh) ───────
FROM ${PYTORCH_DONOR} AS pytorch-donor
FROM ${ROS_BASE} AS jp6-torch-built
RUN rm -f /etc/apt/sources.list.d/* && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* && \
    apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get install -y --no-install-recommends --allow-unauthenticated libopenblas-base && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*
COPY --from=pytorch-donor /usr/local/lib/python3.10/dist-packages/ /tmp/pt-donor/
RUN cd /tmp/pt-donor && \
    mkdir -p /usr/local/lib/python3.10/dist-packages && \
    for item in torch torchgen torchvision triton; do \
        if [ -e "$item" ]; then cp -a "$item" /usr/local/lib/python3.10/dist-packages/; fi; \
    done && \
    shopt -s nullglob && \
    for item in torch-*.dist-info torchvision-*.dist-info triton-*.dist-info; do \
        cp -a "$item" /usr/local/lib/python3.10/dist-packages/; \
    done && \
    rm -rf /tmp/pt-donor

# Use pre-built BASE_IMAGE when set; otherwise use inline jp6-torch-built
FROM ${BASE_IMAGE:-jp6-torch-built}
ARG PYPI_MIRROR APT_MIRROR SHERPA_ONNX_ENABLE_GPU SHERPA_ONNX_GPU_ORT_VERSION SKIP_VOP_DEPS

# jp6/dustynv base sets PIP_INDEX_URL=jetson.webredirect.org (often unreachable)
ENV PIP_INDEX_URL=${PYPI_MIRROR} \
    PIP_EXTRA_INDEX_URL= \
    PIP_TRUSTED_HOST="mirrors.tuna.tsinghua.edu.cn pypi.tuna.tsinghua.edu.cn pypi.org files.pythonhosted.org"

# ── APT mirror (conditional) ─────────────────────────────────────
RUN if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

# ── Switch ROS2 to TUNA mirror + skip expired key (if sources exist) ──
RUN if ls /etc/apt/sources.list.d/*.list 1>/dev/null 2>&1; then \
        sed -i 's|http://packages.ros.org/ros2/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu|g' /etc/apt/sources.list.d/*.list && \
        sed -i 's|deb \[|deb [trusted=yes |g; s|deb http|deb [trusted=yes] http|g' /etc/apt/sources.list.d/ros2*.list; \
    fi

# ── System deps ────────────────────────────────────────────────────
RUN rm -f /etc/apt/sources.list.d/* && rm -rf /var/cache/apt/archives/* /var/lib/apt/lists/* && \
    apt-get -o Acquire::AllowInsecureRepositories=true update && \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
        ffmpeg git cmake build-essential && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} colcon-common-extensions && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} "empy<4"

# ── audio_msgs ROS2 package (Humble already in base) ──────────────
COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    . /opt/ros/humble/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release

# ── Python deps ────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    pyyaml requests websockets webrtcvad websocket-client dashscope psutil && \
    pip3 install --no-cache-dir --no-deps -i ${PYPI_MIRROR} silero-vad

# ── HTMSG deps (KISS-ICP + future semantic) ──────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    kiss-icp scipy

# ── VOP deps (YOLOv8-World) — skip for TTS-only builds (SKIP_VOP_DEPS=ON) ─
RUN if [ "${SKIP_VOP_DEPS}" = "ON" ]; then \
        echo "SKIP_VOP_DEPS=ON, skipping ultralytics/CLIP"; \
    else \
        python3 -c "import cv2" 2>/dev/null || { \
            PYTAG=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')"); \
            CV2PKG="/usr/lib/python${PYTAG}/dist-packages/cv2"; \
            echo 'import importlib.util, sys, os' > "${CV2PKG}/__init__.py" && \
            echo '_so = os.path.join(os.path.dirname(__file__), f"python-{PYTAG}", f"cv2.cpython-{PYTAG}-aarch64-linux-gnu.so")' >> "${CV2PKG}/__init__.py" && \
            echo '_spec = importlib.util.spec_from_file_location("cv2", _so)' >> "${CV2PKG}/__init__.py" && \
            echo '_mod = importlib.util.module_from_spec(_spec)' >> "${CV2PKG}/__init__.py" && \
            echo '_spec.loader.exec_module(_mod)' >> "${CV2PKG}/__init__.py" && \
            echo 'sys.modules["cv2"] = _mod' >> "${CV2PKG}/__init__.py"; \
        } && \
        pip3 install --no-cache-dir --no-deps -i ${PYPI_MIRROR} ultralytics && \
        pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
            matplotlib pandas tqdm "pillow>=7.1.2" psutil py-cpuinfo \
            "ultralytics-thop>=0.2.7" "seaborn>=0.11.0" && \
        pip3 uninstall -y opencv-python opencv-python-headless 2>/dev/null; true && \
        pip3 install --no-cache-dir -i ${PYPI_MIRROR} --no-deps --no-build-isolation \
            "git+https://ghfast.top/https://github.com/ultralytics/CLIP.git" && \
        pip3 install --no-cache-dir -i ${PYPI_MIRROR} ftfy regex && \
        mkdir -p /work/weights/clip && \
        python3 -c "import urllib.request; urllib.request.urlretrieve('https://agi-phanthy-dev-1252788780.cos.ap-beijing.myqcloud.com/public/ViT-B-32.pt', '/work/weights/clip/ViT-B-32.pt')"; \
    fi

# Set YOLO_CONFIG_DIR so WEIGHTS_DIR resolves to /work/weights (VOP only)
ENV YOLO_CONFIG_DIR=/work

# ── sherpa-onnx (on-device ASR/TTS/KWS, GPU build for JetPack 6) ─
# PyPI aarch64 wheel is CPU-only. Build from source with CUDA ORT for JP6.
# Note: pip install . fails when PORTAUDIO=OFF (missing sherpa-onnx-microphone);
# use setup.py build + copy site-packages instead.
RUN if [ "${SHERPA_ONNX_ENABLE_GPU}" = "ON" ]; then \
        pip3 uninstall -y sherpa-onnx 2>/dev/null || true; \
        git clone --depth 1 https://github.com/k2-fsa/sherpa-onnx /tmp/sherpa-onnx && \
        cd /tmp/sherpa-onnx && \
        export SHERPA_ONNX_CMAKE_ARGS="-DSHERPA_ONNX_ENABLE_GPU=ON \
-DSHERPA_ONNX_LINUX_ARM64_GPU_ONNXRUNTIME_VERSION=${SHERPA_ONNX_GPU_ORT_VERSION} \
-DBUILD_SHARED_LIBS=ON \
-DSHERPA_ONNX_ENABLE_PORTAUDIO=OFF \
-DSHERPA_ONNX_ENABLE_WEBSOCKET=OFF \
-DSHERPA_ONNX_ENABLE_TESTS=OFF" && \
        python3 setup.py build && \
        SITE=$(python3 -c "import site; print(site.getsitepackages()[0])") && \
        cp -a build/lib.linux-aarch64-cpython-*/sherpa_onnx "${SITE}/" && \
        rm -rf /tmp/sherpa-onnx; \
    else \
        pip3 install --no-cache-dir -i ${PYPI_MIRROR} sherpa-onnx; \
    fi

# ── Application code ───────────────────────────────────────────────
WORKDIR /work
COPY perception/main.py    /work/main.py
COPY perception/plugins/   /work/plugins/
COPY perception/utils/     /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/deploy/    /deploy/
COPY deploy/judgeflow_tts_run.sh /deploy/judgeflow_tts_run.sh

RUN chmod +x /deploy/entrypoint.sh /deploy/judgeflow_tts_run.sh

EXPOSE 15720
EXPOSE 15721

# NVIDIA container runtime hints (requires --runtime nvidia at docker run)
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility
LABEL com.nvidia.volumes.needed="nvidia_driver"

# 确保 ROS2 Python 包始终在 PYTHONPATH 中（不依赖 source setup.bash）
RUN SITE=$(python3 -c "import site; print(site.getsitepackages()[0])") && \
    find /ros_ws/install -name "site-packages" -type d > "${SITE}/ros_ws.pth" && \
  (find /opt/ros/humble/install -name "site-packages" -type d >> "${SITE}/ros_ws.pth" 2>/dev/null || true)

# ROS2 shared libraries（audio_msgs .so 等）+ JP6 NVIDIA user-space libs
ENV LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu/nvidia:/usr/lib/aarch64-linux-gnu:/usr/local/cuda/lib64:/ros_ws/install/audio_msgs/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/audio_msgs:/opt/ros/humble/install"

# Align with robot-tts-evaluation (ROS_DOMAIN_ID=42, FastDDS DEFAULT transport).
ENV ROS_DOMAIN_ID=42 \
    FASTDDS_BUILTIN_TRANSPORTS=DEFAULT

ENTRYPOINT ["/deploy/entrypoint.sh"]
