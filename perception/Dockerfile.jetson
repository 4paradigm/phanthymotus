# ── Jetson variant (JetPack 5.1.1) ─────────────────────────────────
# Self-contained: builds jp511-torch from public dustynv images — no private
# registry needed. Local builds can skip the inline stage by setting
# BASE_IMAGE=bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp511-torch
# (or via build_perception.sh which does the same).
#
# Build context: repo root (phanthy-motus/) so we can access both
# src/perception_stack/ and deploy/ros-base/audio_msgs/
#
# Usage:
#   docker build -f perception/Dockerfile.jetson --network=host \
#     -t phanthymotus-perception-ocr:jp511 .
#
#   ./deploy/build_perception.sh --variant jetson --mirror tuna
# ────────────────────────────────────────────────────────────────────

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG ROS_BASE=docker.m.daocloud.io/dustynv/ros:humble-desktop-l4t-r35.3.1
ARG PYTORCH_DONOR=docker.m.daocloud.io/dustynv/l4t-pytorch:r35.3.1
ARG BASE_IMAGE=

# ── Stage: jp511-torch (inline, from public dustynv images) ────────
# Both stages use L4T r35.3.1, so the donor's CUDA-enabled PyTorch ABI
# matches the ROS/TensorRT base.
FROM ${PYTORCH_DONOR} AS pytorch-donor
FROM ${ROS_BASE} AS jp511-torch-built
COPY --from=pytorch-donor /usr/local/lib/python3.8/dist-packages/torch/ /usr/local/lib/python3.8/dist-packages/torch/
COPY --from=pytorch-donor /usr/local/lib/python3.8/dist-packages/torch-2.0.0+nv23.5.dist-info/ /usr/local/lib/python3.8/dist-packages/torch-2.0.0+nv23.5.dist-info/
COPY --from=pytorch-donor /usr/local/lib/python3.8/dist-packages/torchgen/ /usr/local/lib/python3.8/dist-packages/torchgen/
COPY --from=pytorch-donor /usr/local/lib/python3.8/dist-packages/torchvision/ /usr/local/lib/python3.8/dist-packages/torchvision/
COPY --from=pytorch-donor /usr/local/lib/python3.8/dist-packages/torchvision-0.15.1a0+42759b1.dist-info/ /usr/local/lib/python3.8/dist-packages/torchvision-0.15.1a0+42759b1.dist-info/

# Use pre-built BASE_IMAGE when set; otherwise use the inline build above
FROM ${BASE_IMAGE:-jp511-torch-built}
ARG PYPI_MIRROR APT_MIRROR

ENV PIP_INDEX_URL=${PYPI_MIRROR} \
    PIP_EXTRA_INDEX_URL= \
    PIP_TRUSTED_HOST="mirrors.tuna.tsinghua.edu.cn pypi.tuna.tsinghua.edu.cn pypi.org files.pythonhosted.org" \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    OPENCV_FOR_THREADS_NUM=1 \
    VIPS_CONCURRENCY=1 \
    MALLOC_ARENA_MAX=2

# ── APT mirror (conditional) ─────────────────────────────────────
RUN if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

# ── System deps ────────────────────────────────────────────────────
# (build-essential + python3-dev: webrtcvad has no aarch64 wheel, builds from source)
RUN rm -f /etc/apt/sources.list.d/* && rm -rf /var/cache/apt/archives/* /var/lib/apt/lists/* && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ffmpeg build-essential python3-dev libopenblas-base libvips42 && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} colcon-common-extensions && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} "empy<4"

# ── audio_msgs ROS2 package (Humble already in base) ──────────────
COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    . /opt/ros/humble/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release

# ── Python deps ────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    "typing_extensions>=4.4,<5" \
    pyyaml requests websockets webrtcvad websocket-client dashscope && \
    pip3 install --no-cache-dir --no-deps -i ${PYPI_MIRROR} silero-vad

# ── HTMSG deps (KISS-ICP + future semantic) ──────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    kiss-icp scipy

# ── VOP deps (YOLOv8-World object detection) ─────────────────────
# Fix the JP511 system cv2 wrapper when its mat_wrapper import is broken.
RUN python3 -c "import cv2" 2>/dev/null || { \
    echo 'import importlib.util, sys, os' > /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo '_so = os.path.join(os.path.dirname(__file__), "python-3.8", "cv2.cpython-38-aarch64-linux-gnu.so")' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo '_spec = importlib.util.spec_from_file_location("cv2", _so)' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo '_mod = importlib.util.module_from_spec(_spec)' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo '_spec.loader.exec_module(_mod)' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py && \
    echo 'sys.modules["cv2"] = _mod' >> /usr/lib/python3.8/dist-packages/cv2/__init__.py; \
    }
# Install ultralytics WITHOUT replacing Jetson's CUDA torch + torchvision
RUN pip3 install --no-cache-dir --no-deps -i ${PYPI_MIRROR} ultralytics && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    matplotlib pandas tqdm "pillow>=7.1.2" psutil py-cpuinfo \
    "ultralytics-thop>=0.2.7" "seaborn>=0.11.0" && \
    pip3 uninstall -y opencv-python opencv-python-headless 2>/dev/null; true
# ultralytics CLIP (needed for set_classes). Force the selected PyPI mirror
# for the isolated build environment.
RUN PIP_INDEX_URL=${PYPI_MIRROR} pip3 install --no-cache-dir --no-deps "git+https://github.com/ultralytics/CLIP.git" && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} ftfy regex

# Pre-download CLIP weights into image (avoids 338MB download at runtime)
RUN mkdir -p /work/weights/clip && \
    python3 -c "import urllib.request; urllib.request.urlretrieve('https://agi-phanthy-dev-1252788780.cos.ap-beijing.myqcloud.com/public/ViT-B-32.pt', '/work/weights/clip/ViT-B-32.pt')"

# Set YOLO_CONFIG_DIR so WEIGHTS_DIR resolves to /work/weights
ENV YOLO_CONFIG_DIR=/work

# ── sherpa-onnx (on-device ASR/TTS/KWS) ──────────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} sherpa-onnx

# ── phonemizer (multilingual IPA via espeak-ng for asr_kws mode) ──
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng && \
    rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} phonemizer

# ── ONNX Runtime CPU (CPython 3.8 / aarch64) ──────────────────────
# Keep the optional ONNX backend available without replacing JetPack's CUDA
# libraries. ORT 1.17.3 and NumPy 1.23.5 are the compatible CPython 3.8 pins.
RUN pip3 uninstall -y onnxruntime onnxruntime-gpu 2>/dev/null || true; \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
      "numpy==1.23.5" "onnxruntime==1.17.3" && \
    python3 -c "import onnxruntime as ort; providers = ort.get_available_providers(); assert ort.__version__ == '1.17.3', ort.__version__; assert 'CPUExecutionProvider' in providers, providers; assert 'CUDAExecutionProvider' not in providers, providers"

# TensorRT is supplied by the JetPack base image. Docker build RUN steps do
# not have the NVIDIA runtime's DLA libraries mounted, so inspect package
# metadata here and leave the actual import/execution check to runtime smoke.
RUN python3 -c "from importlib.metadata import version; value = version('tensorrt'); parts = tuple(int(item) for item in value.split('.')[:2]); assert (8, 5) <= parts < (9, 0), value"

# ── RapidOCR utilities + low-memory MNN OCR runtime ───────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
      "numpy==1.23.5" pyclipper==1.3.0.post3 six Shapely==2.0.5 Pillow \
      omegaconf==2.3.0 colorlog && \
    pip3 install --no-cache-dir --no-deps -i ${PYPI_MIRROR} \
      rapidocr==3.9.1 && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
      "MNN==3.6.0" "pyvips==3.1.0" && \
    RAPIDOCR_MODELS="$(python3 -c 'from pathlib import Path; import rapidocr; print(Path(rapidocr.__file__).resolve().parent / "models")')" && \
    find "${RAPIDOCR_MODELS}" -type f -name '*.onnx' -delete && \
    MNN_GOMP="$(find /usr/local/lib/python3.8/dist-packages/mnn.libs -maxdepth 1 -type f -name 'libgomp-*.so.1.0.0' -print -quit)" && \
    test -n "${MNN_GOMP}" && \
    ln -sfn "${MNN_GOMP}" /usr/local/lib/libgomp-mnn.so.1 && \
    LD_PRELOAD=/usr/local/lib/libgomp-mnn.so.1 \
      python3 -c "import torch, ultralytics, MNN" && \
    rm -rf /work/Ultralytics

# ── OCR model (public ModelScope artifacts, kept outside Git) ─────
ARG OCR_MNN_MODEL_BASE_URL=https://www.modelscope.cn/models/Flame4pd/ppocrv6-small-edge-ocr/resolve/master/mnn
ARG OCR_TRT_MODEL_BASE_URL=https://www.modelscope.cn/models/Flame4pd/ppocrv6-small-edge-ocr/resolve/master/tensorrt-jp511-trt8.5-orin-batch8-cls8
COPY perception/utils/ocr_model_downloader.py /tmp/ocr_model_downloader.py
RUN python3 /tmp/ocr_model_downloader.py \
    --base-url "${OCR_MNN_MODEL_BASE_URL}" \
    --output-dir /opt/phanthy-motus/model-seed/ocr/ppocrv6-small-mnn \
    --filenames det.mnn rec.mnn keys.txt \
    --sha256 det.mnn=a41bcf051c24b67c46172005915f8b8f6a0272cb30b11bf9f16cca4231d21ee1 \
    --sha256 rec.mnn=3ed704bdc5495002225237444384437617777bd962fa048d5d09d1444b98564b \
    --sha256 keys.txt=b5f2bfe2bdd9448429e3e82b51c789775d9b42f2403d082b00662eb77e401c5d && \
    python3 /tmp/ocr_model_downloader.py \
    --base-url "${OCR_TRT_MODEL_BASE_URL}" \
    --output-dir /opt/phanthy-motus/model-seed/ocr/ppocrv6-small-trt-jp511-trt8.5-orin-batch8-cls8 \
    --filenames det.engine rec.engine cls.engine keys.txt \
    --sha256 det.engine=1bb32a027e93b06d5319ac61e38bb3e447137b01465eacefa7a652f58130ebdf \
    --sha256 rec.engine=1e204f0469beba33d8590b29c06419cf1073d98d41243b5ee316d2f877340b61 \
    --sha256 cls.engine=02c722e56e621b56a36678cc8aa124a31b41e9e3c9ca350b11e4de0d5bbd0a35 \
    --sha256 keys.txt=b5f2bfe2bdd9448429e3e82b51c789775d9b42f2403d082b00662eb77e401c5d

# ── Application code ───────────────────────────────────────────────
WORKDIR /work
COPY perception/main.py    /work/main.py
COPY perception/plugins/   /work/plugins/
COPY perception/utils/     /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/config/fastdds_large_message.xml /opt/phanthy-motus/config/fastdds_large_message.xml
COPY perception/deploy/seed_ocr_models.sh /deploy/seed_ocr_models.sh
RUN chmod 0755 /deploy/seed_ocr_models.sh

EXPOSE 15720
EXPOSE 15721

# 确保 ROS2 Python 包始终在 PYTHONPATH 中（不依赖 source setup.bash）
RUN find /ros_ws/install /opt/ros/humble/install -type d \( -name "site-packages" -o -name "dist-packages" \) \
      > /usr/local/lib/python3.8/dist-packages/ros_ws.pth

# ROS2 shared libraries（audio_msgs .so 等）
ENV LD_LIBRARY_PATH="/ros_ws/install/audio_msgs/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/audio_msgs:/opt/ros/humble/install"

CMD ["/bin/bash", "-c", \
    "export LD_PRELOAD=/usr/local/lib/libgomp-mnn.so.1 && \
     /deploy/seed_ocr_models.sh && \
     source /opt/ros/humble/install/setup.bash && \
     source /ros_ws/install/setup.bash && \
     python3 /work/main.py"]
