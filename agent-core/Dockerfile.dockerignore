# Runtime/private data and local build artifacts must stay out even though
# their parent source/resource trees are allowlisted above.
agent-core/resource/*.db
agent-core/resource/**/*.db
agent-core/resource/*.db-*
agent-core/resource/**/*.db-*
agent-core/resource/*.sqlite3
agent-core/resource/**/*.sqlite3
