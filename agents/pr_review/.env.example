# ── GitHub ────────────────────────────────────────────────────────────────────
# Classic PAT with the `repo` scope. One token covers both repos.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_personal_access_token

# Repos to watch (comma-separated). Defaults to the two phanthymotus repos.
# GITHUB_REPOS=4paradigm/phanthymotus,4paradigm/phanthymotus-driver

# How git reaches GitHub: ssh | https
#
# Defaults to ssh, and NOT for authentication — both repos are public. It is a
# reachability problem: on the Tencent hosts, TCP to github.com:443 completes but
# the TLS handshake is dropped (SNI filtering), so git over HTTPS fails every
# time, while api.github.com and SSH both work. Measured: git-over-HTTPS 0/6,
# git-over-SSH 3/3.
#
# ssh   needs a key mounted at /root/.ssh (compose mounts $SSH_DIR read-only)
# https no key needed; only use it where github.com:443 is genuinely reachable
GIT_TRANSPORT=ssh
SSH_DIR=/root/.ssh

# ── Trigger mode ──────────────────────────────────────────────────────────────
# Polling needs only outbound network: no public IP, no open port, no webhook
# registration. This is the default.
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=30
# On first start (no saved state), how far back to look for trigger comments.
POLL_INITIAL_LOOKBACK_MINUTES=10

# Webhook is optional and only useful if GitHub can reach this host inbound.
# Leaving it on is harmless — behind NAT it simply never receives anything.
WEBHOOK_ENABLED=true
# Required only when the webhook is actually reachable. Generate with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ── Mirrors ───────────────────────────────────────────────────────────────────
# Which mirror the repos' build scripts use when building core/perception/driver
# images. Passed through to build_core.sh / build_perception.sh / build.sh.
MIRROR=tencent

# Mirrors for building the agent's *own* image. Defaults are Tencent Cloud;
# uncomment and change these only if this host is outside the Tencent VPC.
# MIRROR_BASE=docker.io
# PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# BINFMT_IMAGE=docker.io/tonistiigi/binfmt
# DOCKER_REPO=https://download.docker.com/linux/debian

# ── Registry ──────────────────────────────────────────────────────────────────
REGISTRY=ccr.ccs.tencentyun.com
REGISTRY_USER=your_registry_user
REGISTRY_PASSWORD=your_registry_password
IMAGE_NAMESPACE=phanthy-motus
IMAGE_NAMESPACE_DRIVERS=phanthy-motus/drivers
PUSH_ENABLED=true

# ── LLM review (OpenAI-compatible /v1/chat/completions) ───────────────────────
# Any of these forms works — /v1 is added when missing:
#   https://router.example.com                     -> /v1/chat/completions
#   https://api.example.com/v1                     -> /v1/chat/completions
#   https://api.example.com/v1/chat/completions    -> used as-is
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=claude-sonnet-4-20250514
MAX_DIFF_LINES=3000
# Response budget and timeout for the review call. An empty completion is
# retried; if it keeps coming back empty the PR comment says so rather than
# posting a blank review.
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=180

# ── Worker ────────────────────────────────────────────────────────────────────
# Concurrent review jobs. Each gets its own git worktree, so they cannot
# interfere; raise this if the host has spare CPU and disk.
MAX_CONCURRENT_JOBS=2

# Timeout for a single `docker build` invocation.
BUILD_TIMEOUT_SECONDS=1800

# Whole-job timeout. A job exceeding this is presumed lost and retried.
# NOTE: builds run sequentially, so a PR touching N drivers needs roughly
# N * BUILD_TIMEOUT_SECONDS. Raise this if PRs routinely touch several drivers.
JOB_TIMEOUT_SECONDS=3600

# Total attempts per job including the first (3 = two retries). Only timeouts
# and infrastructure failures are retried; merge conflicts and genuine build
# failures are reported immediately.
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=60

# How long job history and build logs are kept. Pruned at startup; log files are
# deleted with their job row so the two never drift.
JOB_HISTORY_DAYS=30

# ── Paths / server ────────────────────────────────────────────────────────────
# Where the agent keeps its state INSIDE the container. Leave this alone.
DATA_DIR=/data/repos

# Where that state lives ON THE HOST. Holds jobs.db (review history), full build
# logs, the bare clones, and the poller watermarks. A bind mount rather than a
# named volume so the path is discoverable, backups are a plain
#   tar czf backup.tar.gz /opt/phanthy-motus/pr-review
# and `deploy.sh down --purge` cannot take the history with it.
DATA_HOST_DIR=/opt/phanthy-motus/pr-review

# The dashboard and the API are both served from PORT.
#
# HOST is what uvicorn binds *inside* the container — leave it at 0.0.0.0.
# BIND_ADDR is what compose publishes on the *host*, and is the one that decides
# who can reach the dashboard:
#   0.0.0.0    reachable from the LAN at http://<host-ip>:<PORT>/   (default)
#   127.0.0.1  loopback only; reach it with
#              ssh -L <PORT>:localhost:<PORT> <user>@<host>
#
# The dashboard has NO authentication, and build logs can contain sensitive
# output. 0.0.0.0 is fine on a trusted private network; on a shared or
# internet-facing host use 127.0.0.1 and tunnel.
HOST=0.0.0.0
BIND_ADDR=0.0.0.0
PORT=25000

# ── Resource Center (optional) ────────────────────────────────────────────────
# RESOURCE_CENTER_URL=https://motus.phanthy.com
# RESOURCE_CENTER_API_KEY=rc_your_key
