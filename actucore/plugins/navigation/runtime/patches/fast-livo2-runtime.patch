+void LIVMapper::publishRuntimeDiagnostics()
+{
+  size_t lidar_buffer_size = 0;
+  size_t imu_buffer_size = 0;
+  double lidar_buffer_span_sec = 0.0;
+  double imu_buffer_span_sec = 0.0;
+  std::string lidar_frame;
+  std::string imu_frame;
+  {
+    std::lock_guard<std::mutex> lock(mtx_buffer);
+    lidar_buffer_size = lid_raw_data_buffer.size();
+    imu_buffer_size = imu_buffer.size();
+    lidar_frame = last_lidar_frame;
+    imu_frame = last_imu_frame;
+    if (lid_header_time_buffer.size() > 1) {
+      lidar_buffer_span_sec = std::max(
+        0.0, lid_header_time_buffer.back() - lid_header_time_buffer.front());
+    }
+    if (imu_buffer.size() > 1) {
+      imu_buffer_span_sec = std::max(
+        0.0,
+        stamp2Sec(imu_buffer.back()->header.stamp) -
+          stamp2Sec(imu_buffer.front()->header.stamp));
+    }
+  }
+  const double now_sec = this->node->now().seconds();
+  const double processed_source_age_sec =
+    last_processed_source_stamp_sec < 0.0
+      ? -1.0
+      : now_sec - last_processed_source_stamp_sec;
+  const double lidar_source_age_sec =
+    last_timestamp_lidar < 0.0 ? -1.0 : now_sec - last_timestamp_lidar;
+  const double imu_source_age_sec =
+    last_timestamp_imu < 0.0 ? -1.0 : now_sec - last_timestamp_imu;
+  const bool input_contract_ready =
+    !lidar_frame.empty() && lidar_frame == imu_frame &&
+    last_point_time_span_ms > 0.0 && last_point_time_span_ms <= 200.0;
+
+  std::ostringstream payload;
+  payload << "{\"schema\":\"phanthy.navigation.fast_livo2_mapper_runtime.v1\""
+          << ",\"lidar_callbacks\":" << lidar_callback_count
+          << ",\"imu_callbacks\":" << imu_callback_count
+          << ",\"processed_lidar\":" << processed_lidar_count
+          << ",\"lidar_frame\":" << std::quoted(lidar_frame)
+          << ",\"imu_frame\":" << std::quoted(imu_frame)
+          << ",\"last_lidar_source_stamp_sec\":" << last_timestamp_lidar
+          << ",\"last_imu_source_stamp_sec\":" << last_timestamp_imu
+          << ",\"point_time_span_ms\":" << last_point_time_span_ms
+          << ",\"input_contract_ready\":"
+          << (input_contract_ready ? "true" : "false")
+          << ",\"wait_for_imu\":" << wait_for_imu_count
+          << ",\"lidar_buffer_size\":" << lidar_buffer_size
+          << ",\"imu_buffer_size\":" << imu_buffer_size
+          << ",\"lidar_buffer_span_sec\":" << lidar_buffer_span_sec
+          << ",\"imu_buffer_span_sec\":" << imu_buffer_span_sec
+          << ",\"max_lidar_buffer_size\":" << max_lidar_buffer_size
+          << ",\"max_imu_buffer_size\":" << max_imu_buffer_size
+          << ",\"max_lidar_buffer_span_sec\":" << max_lidar_buffer_span_sec
+          << ",\"max_imu_buffer_span_sec\":" << max_imu_buffer_span_sec
+          << ",\"last_processed_source_stamp_sec\":" << last_processed_source_stamp_sec
+          << ",\"processed_source_age_sec\":" << processed_source_age_sec
+          << ",\"lidar_source_age_sec\":" << lidar_source_age_sec
+          << ",\"imu_source_age_sec\":" << imu_source_age_sec
+          << ",\"processing_ms\":" << last_processing_ms
+          << ",\"max_processing_ms\":" << max_processing_ms
+          << ",\"effective_feature_count\":" << last_effective_feature_count
+          << ",\"consecutive_zero_effective_features\":"
+          << consecutive_zero_effective_features
+          << ",\"mean_residual\":" << last_mean_residual
+          << "}";
+  std_msgs::msg::String message;
+  message.data = payload.str();
+  runtime_diagnostics_pub->publish(message);
+}
