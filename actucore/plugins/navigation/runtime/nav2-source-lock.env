# Nav2 runtime lock for the ActuCore image.
#
# ActuCore's base image (jetson-base:jp*-torch) is Ubuntu 20.04 with a
# source-built ROS Humble install-space under /opt/ros/humble/install.  The
# ros-humble-* Debian archive only exists for Jammy, so Nav2 and the four
# dependency repositories it needs beyond the base are built from locked
# sources instead of pinned apt versions.
#
# navigation2 is pinned to the SAME upstream release the previous apt build
# used (1.1.20), so the runtime behaviour of the card does not change with the
# packaging form.
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
APT_UBUNTU_MIRROR=mirrors.tuna.tsinghua.edu.cn
GIT_MIRROR_PREFIX=https://ghfast.top/

# navigation2 tag 1.1.20 — matches the retired ros-humble-navigation2 1.1.20-1jammy pin
NAVIGATION2_REPO=https://github.com/ros-navigation/navigation2.git
NAVIGATION2_COMMIT=a097086719c88f781aa59788eca29ac6ca5e56db

# behaviortree_cpp_v3 tag 3.8.8 — the version ROS Humble releases for v3
BEHAVIORTREE_CPP_REPO=https://github.com/BehaviorTree/BehaviorTree.CPP.git
BEHAVIORTREE_CPP_COMMIT=9d624dc7797b4752e5f8616793ffcee4b540a185

# angles humble-devel — nav2_costmap_2d / dwb_critics
ANGLES_REPO=https://github.com/ros/angles.git
ANGLES_COMMIT=4b71a44dd2b3a24d7af30bf94b0ba34ece1d0558

# bond_core humble — nav2_lifecycle_manager bond heartbeats
BOND_CORE_REPO=https://github.com/ros/bond_core.git
BOND_CORE_COMMIT=1e589099eb383e488e6078154018cd382a792ea8

# diagnostics ros2-humble — diagnostic_updater, used by nav2_util
DIAGNOSTICS_REPO=https://github.com/ros/diagnostics.git
DIAGNOSTICS_COMMIT=de779cfd3bff7975f158971c58bedf0581148f9a

# navigation_msgs humble — map_msgs, used by nav2_costmap_2d
NAVIGATION_MSGS_REPO=https://github.com/ros-planning/navigation_msgs.git
NAVIGATION_MSGS_COMMIT=1d8683359734a2c829b5cdb6b5a4e015bbbcb6a5

# laser_geometry humble — nav2_costmap_2d obstacle layer
LASER_GEOMETRY_REPO=https://github.com/ros-perception/laser_geometry.git
LASER_GEOMETRY_COMMIT=d53b925d25b4b5657261a44f4479365965cc2363
