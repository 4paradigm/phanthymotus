# ── Jetson ActuCore runtime ─────────────────────────────────────────
# Expensive locked third-party navigation dependencies live in the digest-pinned
# navigation base. This image only rebuilds repository-owned ROS packages and app code.
ARG ACTUCORE_NAVIGATION_BASE_IMAGE
FROM ${ACTUCORE_NAVIGATION_BASE_IMAGE}
ARG ACTUCORE_NAVIGATION_BASE_IMAGE

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG BUILD_JOBS=4

COPY actucore/plugins/navigation/runtime/g1_fast_livo2/ /ros_ws/src/g1_fast_livo2/
COPY actucore/plugins/navigation/runtime/g1_nav2/ /ros_ws/src/g1_nav2/
COPY actucore/plugins/navigation/runtime/g1_segmented_controller/ /ros_ws/src/g1_segmented_controller/
RUN source /opt/ros/humble/install/setup.bash && \
    source /opt/ros_deps_ws/install/setup.bash && \
    source /opt/nav2_ws/install/setup.bash && \
    source /opt/fast_livo_ws/install/setup.bash && \
    cd /ros_ws && \
    MAKEFLAGS="-j${BUILD_JOBS}" colcon build \
      --packages-select g1_fast_livo2 g1_segmented_controller g1_nav2 \
      --symlink-install && \
    source /ros_ws/install/setup.bash && \
    ros2 pkg prefix g1_segmented_controller >/dev/null && \
    python3 -c "import numpy, rosbag2_py, yaml, em; import cv2; from g1_fast_livo2.camera_rgb_frame import decode as decode_rgb, MAGIC as RGB_MAGIC; from g1_fast_livo2.camera_depth_frame import decode as decode_depth, MAGIC as DEPTH_MAGIC; assert RGB_MAGIC == DEPTH_MAGIC == b'PSE1'" && \
    ros2 bag record --help >/dev/null

COPY actucore/plugins/navigation/runtime/navigation_lio.yaml /config/navigation_lio.yaml

WORKDIR /work
COPY actucore/main.py     /work/main.py
COPY actucore/plugins/    /work/plugins/
COPY actucore/utils/      /work/utils/
COPY actucore/config.yaml /work/config.yaml
COPY actucore/deploy/     /deploy/

EXPOSE 15730

RUN find /ros_ws/install /opt/nav2_ws/install /opt/ros_deps_ws/install \
      /opt/fast_livo_ws/install -name "site-packages" -type d \
      > /usr/local/lib/python${PYTHON_VERSION-3.8}/dist-packages/ros_ws.pth && \
    find /opt/ros/humble/install -name "site-packages" -type d \
      >> /usr/local/lib/python${PYTHON_VERSION-3.8}/dist-packages/ros_ws.pth && \
    echo /work \
      >> /usr/local/lib/python${PYTHON_VERSION-3.8}/dist-packages/ros_ws.pth && \
    cd / && python3 -c "from utils import logsafe"

ENV LD_LIBRARY_PATH="/opt/fast_livo_ws/install/fast_livo/lib:/opt/fast_livo_ws/install/livox_ros_driver2/lib:/opt/fast_livo_ws/install/vikit_common/lib:/opt/fast_livo_ws/install/vikit_ros/lib:/opt/nav2_ws/install/lib:/opt/ros_deps_ws/install/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/g1_fast_livo2:/ros_ws/install/g1_segmented_controller:/ros_ws/install/g1_nav2:/opt/nav2_ws/install:/opt/ros_deps_ws/install:/opt/ros/humble/install"
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_DOMAIN_ID=42
ENV FASTDDS_BUILTIN_TRANSPORTS=DEFAULT
ENV RCUTILS_LOGGING_BUFFERED_STREAM=1

LABEL org.opencontainers.image.title="Phanthy Motus ActuCore" \
      org.opencontainers.image.description="执行模型层 — navigation 卡片（FAST-LIVO2 + Nav2 + 语义航点）" \
      org.opencontainers.image.licenses="Apache-2.0 AND GPL-2.0-only AND GPL-3.0-only" \
      org.opencontainers.image.base.name="${ACTUCORE_NAVIGATION_BASE_IMAGE}"

CMD ["/bin/bash", "-c", \
    "export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 && \
     source /opt/ros/humble/install/setup.bash && \
     source /opt/ros_deps_ws/install/setup.bash && \
     source /opt/nav2_ws/install/setup.bash && \
     source /opt/fast_livo_ws/install/setup.bash && \
     source /ros_ws/install/setup.bash && \
     exec python3 /work/main.py"]
