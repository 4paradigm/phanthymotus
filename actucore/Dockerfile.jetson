# ── Jetson GPU variant ──────────────────────────────────────────────
# One Dockerfile for both JetPack lines; the base comes in as BASE_IMAGE (see
# below). The card sources are shared; JP6.1 also installs the teleop bundle.
#
# Build context: repo root (phanthymotus/) so we can access both
# actucore/ and deploy/ros-base/audio_msgs/
#
# Usage:
#   ./deploy/build_actucore.sh --mirror tuna                  # jp5.11 (default)
#   ./deploy/build_actucore.sh --jp-version 6.1 --mirror tuna
# ────────────────────────────────────────────────────────────────────

ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# Defaults match deploy/build_actucore.sh, which matches build_perception.sh.
# The script always passes both explicitly; these only apply to a bare
# `docker build`, and having them disagree with the script would mean the same
# command producing a different image depending on how it was invoked.
ARG JP_VERSION=511
# One Dockerfile, two bases. JP6.1 includes the teleop dependencies alongside
# VLA; JP5.11 preserves its older Python/numeric environment:
#
#   jp5.11  jetson-base            remote providers only. Thin. (default)
#   jp6.1   jetson-base-actucore   CUDA torch 2.9 + lerobot → local *and* remote
#                                  providers. ~18.6 GB.
#
# That split is forced, not chosen. JetPack 5.11 is CUDA 11.4 and lerobot needs
# torch >= 2.2.1, and no torch >= 2.2 supports CUDA 11.4 (PyTorch's own matrix
# floors at 11.8) — so local inference cannot exist there whatever we build.
# The `smolvla` provider refuses at start on that line with that reason; `mock`
# and `vla_cloud` are unaffected. See deploy/prepare_actucore_base.sh.
ARG BASE_IMAGE=bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp511-torch
FROM ${BASE_IMAGE}
ARG PYPI_MIRROR APT_MIRROR
ARG JP_VERSION

# ── APT mirror (conditional) ─────────────────────────────────────
RUN if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

# ── Switch ROS2 to TUNA mirror + skip expired key (if sources exist) ──
RUN if ls /etc/apt/sources.list.d/*.list 1>/dev/null 2>&1; then \
        sed -i 's|http://packages.ros.org/ros2/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ros2/ubuntu|g' /etc/apt/sources.list.d/*.list && \
        sed -i 's|deb \[|deb [trusted=yes |g; s|deb http|deb [trusted=yes] http|g' /etc/apt/sources.list.d/ros2*.list; \
    fi

RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} colcon-common-extensions && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} "empy<4"

# ── audio_msgs ROS2 package (Humble already in base) ──────────────
# Built here so both variants expose the same ROS message set as ros-base does
# — otherwise a card would work on CPU and fail to import on Jetson.
COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    . /opt/ros/humble/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release

# ── Python deps ────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
    pyyaml requests

# Teleop is included on JP6.1 in this same process, using VLA-compatible pins.
# Keep the old build argument accepted; JP_VERSION now selects the dependencies,
# including when the existing build script passes WITH_TELEOP=0.
ARG WITH_TELEOP=0
COPY actucore/plugins/teleop/requirements.bundle.lock /tmp/teleop-bundle.lock
# Fetch the fixed, signed PICO APK as part of the ordinary image build.
COPY actucore/openxr_capture_native/package-manifest.json /tmp/pico-package.json
COPY actucore/openxr_capture_native/scripts/fetch_apk.py /tmp/fetch_pico_apk.py
RUN if [ "$JP_VERSION" = "61" ]; then \
        python3 /tmp/fetch_pico_apk.py /tmp/pico-package.json /work/onboarding; \
    fi
RUN if [ "$JP_VERSION" = "61" ]; then \
        python3 -m pip install --no-cache-dir --require-hashes -i ${PYPI_MIRROR} -r /tmp/teleop-bundle.lock && \
        python3 -c 'import pinocchio, scipy, aiortc, av'; \
    fi

# ── Application code ───────────────────────────────────────────────
WORKDIR /work
COPY actucore/main.py     /work/main.py
COPY actucore/plugins/    /work/plugins/
RUN if [ "$JP_VERSION" = "61" ]; then \
        python3 /work/plugins/teleop/onboarding.py /work/onboarding; \
    fi
COPY deploy/fetch_g1_collision.py /tmp/fetch_g1_collision.py
RUN if [ "$JP_VERSION" = "61" ]; then \
        python3 /tmp/fetch_g1_collision.py --manifest-dir /work/plugins/teleop/models/g1_collision; \
    fi
COPY actucore/config.yaml /work/config.yaml
# Atomic-write stdout guard. The build context is the repo root, so this reuses
# perception's copy instead of adding a fourth one to keep in sync — see the
# DUPLICATION note in perception/utils/logsafe.py.
COPY perception/utils/logsafe.py /work/logsafe.py
# COS downloader with size/SHA256 pinning, for cards that fetch weights at
# runtime (plugins/vla's smolvla provider). Same reasoning as logsafe above:
# reuse perception's copy rather than keeping a second one in sync. It carries
# the parts that are easy to get wrong — a check file that must not appear
# until the model behind it is complete, a lock so concurrent starts fetch one
# copy, archives staged before they are merged.
COPY perception/utils/model_downloader.py /work/model_downloader.py
# The status-line helper that turns that downloader's callbacks into the one
# string a card shows. Same reuse rule again — and it must travel with the
# downloader: smolvla imports both, so shipping one without the other fails at
# card start, on a robot, with an ImportError nothing here would have caught.
COPY perception/utils/model_progress.py /work/model_progress.py
# Agent Core reads /deploy/service.yml out of the image to merge the compose
# fragment — dropping this COPY silently falls back to the legacy docker-run path.
COPY actucore/deploy/     /deploy/
# Teleop checks the host DDS profile against this bundled reference.
COPY agent-core/deploy/dds-local.xml /deploy/dds-local.xml

EXPOSE 15730 15741

# 确保 ROS2 Python 包始终在 PYTHONPATH 中（不依赖 source setup.bash）
RUN find /ros_ws/install -name "site-packages" -type d > /usr/local/lib/python${PYTHON_VERSION-3.8}/dist-packages/ros_ws.pth && \
    find /opt/ros/humble/install -name "site-packages" -type d >> /usr/local/lib/python${PYTHON_VERSION-3.8}/dist-packages/ros_ws.pth

# ROS2 shared libraries（audio_msgs .so 等）
ENV LD_LIBRARY_PATH="/ros_ws/install/audio_msgs/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/ros_ws/install/audio_msgs:/opt/ros/humble/install"

ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV ROS_DOMAIN_ID=42

CMD ["/bin/bash", "-c", \
    "export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 && \
     source /opt/ros/humble/install/setup.bash && \
     source /ros_ws/install/setup.bash && \
     python3 /work/main.py"]
