# ── GitHub ────────────────────────────────────────────────────────────────────
# Classic PAT with the `repo` scope. One token covers both repos.
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_personal_access_token

# Repos to watch (comma-separated). Defaults to the two phanthymotus repos.
# GITHUB_REPOS=4paradigm/phanthymotus,4paradigm/phanthymotus-driver

# How git reaches GitHub: ssh | https
#
# Defaults to ssh, and NOT for authentication — both repos are public. It is a
# reachability problem: on the Tencent hosts, TCP to github.com:443 completes but
# the TLS handshake is dropped (SNI filtering), so git over HTTPS fails every
# time, while api.github.com and SSH both work. Measured: git-over-HTTPS 0/6,
# git-over-SSH 3/3.
#
# ssh   needs a key mounted at /root/.ssh (compose mounts $SSH_DIR read-only)
# https no key needed; only use it where github.com:443 is genuinely reachable
GIT_TRANSPORT=ssh
SSH_DIR=/root/.ssh

# ── Trigger mode ──────────────────────────────────────────────────────────────
# Polling needs only outbound network: no public IP, no open port, no webhook
# registration. This is the default.
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=30
# On first start (no saved state), how far back to look for trigger comments.
POLL_INITIAL_LOOKBACK_MINUTES=10

# Webhook is optional and only useful if GitHub can reach this host inbound.
# Leaving it on is harmless — behind NAT it simply never receives anything.
WEBHOOK_ENABLED=true
# Required only when the webhook is actually reachable. Generate with:
#   openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ── Mirrors ───────────────────────────────────────────────────────────────────
# Which mirror the repos' build scripts use when building core/perception/driver
# images. Passed through to build_core.sh / build_perception.sh / build.sh.
MIRROR=tencent

# Mirrors for building the agent's *own* image. Defaults are Tencent Cloud;
# uncomment and change these only if this host is outside the Tencent VPC.
# MIRROR_BASE=docker.io
# PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# BINFMT_IMAGE=docker.io/tonistiigi/binfmt
# DOCKER_REPO=https://download.docker.com/linux/debian

# ── Registry ──────────────────────────────────────────────────────────────────
REGISTRY=ccr.ccs.tencentyun.com
REGISTRY_USER=your_registry_user
REGISTRY_PASSWORD=your_registry_password
IMAGE_NAMESPACE=phanthy-motus
IMAGE_NAMESPACE_DRIVERS=phanthy-motus/drivers
PUSH_ENABLED=true

# ── LLM review (OpenAI-compatible /v1/chat/completions) ───────────────────────
# Any of these forms works — /v1 is added when missing:
#   https://router.example.com                     -> /v1/chat/completions
#   https://api.example.com/v1                     -> /v1/chat/completions
#   https://api.example.com/v1/chat/completions    -> used as-is
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=claude-sonnet-4-20250514
# Response budget and timeout for a single call in the loop. An empty completion
# is retried; if it keeps coming back empty the PR comment says so rather than
# posting a blank review.
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=180
# Legacy: the loop reads the worktree itself rather than being handed a diff, so
# nothing truncates to this any more. Kept because deployed .env files set it.
MAX_DIFF_LINES=3000

# ── Review loop budget ────────────────────────────────────────────────────────
# Rounds of tool use per review, and the wall-clock ceiling. Exhausting either
# posts what was found, explicitly marked as cut short. Observed: a 6-file
# driver PR finished in 5 rounds / 29 tool calls / ~160s.
REVIEW_MAX_ROUNDS=20
REVIEW_TIMEOUT_SECONDS=600

# Added/modified files at or above this are listed separately in the review and
# should live in COS instead of the repo.
LARGE_FILE_THRESHOLD_KB=500

# ── PR context ────────────────────────────────────────────────────────────────
# How much of the PR's own description and discussion the reviewer is given.
# Bounded because it is untrusted, author-written text sharing a context window
# with the review rules. The agent's own comments are always filtered out.
PR_CONTEXT_MAX_CHARS=4000
PR_CONTEXT_MAX_COMMENTS=20

# ── Worker ────────────────────────────────────────────────────────────────────
# Concurrent review jobs. Each gets its own git worktree, so they cannot
# interfere; raise this if the host has spare CPU and disk.
MAX_CONCURRENT_JOBS=2

# What actually bounds a build: seconds since its last line of output. A live
# docker build prints constantly (buildx progress, compiler lines, layer
# exports), so silence for this long means it is wedged — not merely slow.
# Raise it only if a build here legitimately goes quiet for longer than 10 min.
BUILD_IDLE_TIMEOUT_SECONDS=600

# Absolute backstop for one `docker build`, for what the idle bound cannot see:
# a build that prints forever without ever finishing. Not the usual limit —
# a slow-but-progressing build is expected to run for an hour or more (compiling
# openfst or torch extensions on ARM does).
BUILD_TIMEOUT_SECONDS=7200

# ── Tests ─────────────────────────────────────────────────────────────────────
# After a build succeeds, the agent runs that component's own test suite
# (`agent-core/tests`, `perception/tests`) *inside the image it just built*,
# reports the result on the PR and feeds any failures to the reviewer as
# context. Failures never block the review.
#
# Inside the image, not in this container, because perception's suite skips
# large parts of itself when pythainlp / khanaa / jieba / pypinyin / wetext are
# absent — a hand-maintained copy of its dependencies that fell behind would not
# go red, it would quietly run ~10 fewer tests and still report green.
#
# The consequence to know: a component this job did not build gets no test
# result. `skip-build` therefore means no tests, reported as "not run" rather
# than faked from a stale image.
TESTS_ENABLED=true

# Which suites to run, comma-separated. Only these two exist.
TEST_COMPONENTS=agent-core,perception

# These bound a wedged container, not a slow suite. Measured on the perception
# suite (787 tests): 34s native on an Orin, 61s under qemu on the x86 build
# host. Emulating arm64 costs ~1.8x, not the order of magnitude it is easy to
# assume, so an x86 host has no reason to skip the arm64 images.
#
# The idle bound is the generous one because the first run on a host pulls a
# multi-GB image before pytest prints anything at all.
TEST_TIMEOUT_SECONDS=3600
TEST_IDLE_TIMEOUT_SECONDS=900

# Neither image ships pytest — adding it would grow every production image on
# every robot for a CI-only dependency — so it is installed into the container
# at run time. Pinned: an unpinned major would silently change collection
# behaviour across every deployment on whatever Tuesday it ships.
# TEST_PYTEST_SPEC=pytest==8.3.4 pytest-asyncio
# TEST_PYPI_INDEX=https://mirrors.tencentyun.com/pypi/simple/

# Ceiling for one test container, so a runaway test cannot take the build host
# with it.
# TEST_MEMORY_LIMIT=8g

# How many failing tests are quoted in the PR comment and fed to the reviewer.
# TEST_MAX_REPORTED_FAILURES=5
# TEST_CONTEXT_MAX_CHARS=3000

# Whole-job backstop. A job exceeding this is presumed lost and retried.
# Loose on purpose: git, the review loop and each build are all bounded on their
# own, so this only catches the agent itself being stuck.
JOB_TIMEOUT_SECONDS=14400

# Total attempts per job including the first (3 = two retries). Only timeouts
# and infrastructure failures are retried; merge conflicts and genuine build
# failures are reported immediately.
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=60

# How long job history and build logs are kept. Pruned at startup; log files are
# deleted with their job row so the two never drift.
JOB_HISTORY_DAYS=30

# ── Paths / server ────────────────────────────────────────────────────────────
# Where the agent keeps its state INSIDE the container. Leave this alone.
DATA_DIR=/data/repos

# Where that state lives ON THE HOST. Holds jobs.db (review history), full build
# logs, the bare clones, and the poller watermarks. A bind mount rather than a
# named volume so the path is discoverable, backups are a plain
#   tar czf backup.tar.gz /opt/phanthy-motus/pr-review
# and `deploy.sh down --purge` cannot take the history with it.
#
# The test stage also needs this one *inside* the container: `docker run -v` is
# resolved by the **daemon**, so it needs the host path, not the container one.
# Builds never needed it (docker build ships its context over the socket).
#
# The compose file passes it through under `environment:` with the same default
# as the mount, so leaving this commented out still works. It did not always:
# the mount had a default and the variable did not, which produced a working
# mount and a container that could not name it, and the test stage refused to
# run rather than mount a phantom directory. Set it here only if you also
# changed the path.
#
# If the agent ever reports "DATA_HOST_DIR is not set", the container predates
# that compose change — `docker compose up -d --force-recreate` picks it up.
# A restart will not: environment is fixed at container creation.
DATA_HOST_DIR=/opt/phanthy-motus/pr-review

# The dashboard and the API are both served from PORT.
#
# HOST is what uvicorn binds *inside* the container — leave it at 0.0.0.0.
# BIND_ADDR is what compose publishes on the *host*, and is the one that decides
# who can reach the dashboard:
#   0.0.0.0    reachable from the LAN at http://<host-ip>:<PORT>/   (default)
#   127.0.0.1  loopback only; reach it with
#              ssh -L <PORT>:localhost:<PORT> <user>@<host>
#
# The dashboard has NO authentication, and build logs can contain sensitive
# output. 0.0.0.0 is fine on a trusted private network; on a shared or
# internet-facing host use 127.0.0.1 and tunnel.
HOST=0.0.0.0
BIND_ADDR=0.0.0.0
PORT=25000

# ── Resource Center (optional) ────────────────────────────────────────────────
# Setting the key IS the opt-in to publishing: with it set, every successful PR
# build is registered into the image catalog — unreviewed and unmerged code
# included. There is no terminal in the container to confirm on, so nothing
# prompts. Leave it unset to keep the catalog to deliberate builds only.
# RESOURCE_CENTER_URL=https://motus.phanthy.com
# RESOURCE_CENTER_API_KEY=rc_your_key
